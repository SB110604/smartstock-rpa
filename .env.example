# ---------------------------------------------------------------------------
# SmartStock RPA — environment configuration. Copy to .env and adjust.
# Every value has a working default for `docker compose up`; nothing external is required.
# ---------------------------------------------------------------------------

# --- Core ---
APP_ENV=development                 # development | production | test
SECRET_KEY=change-me-to-a-long-random-string
TZ=Asia/Kolkata
FRONTEND_URL=http://localhost:5173  # used in email links and CORS
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# --- Database (PostgreSQL 16) ---
POSTGRES_USER=smartstock
POSTGRES_PASSWORD=smartstock
POSTGRES_DB=smartstock
# Connection URLs: docker compose sets these to the `db` container itself. Without Docker the defaults are
# localhost:5433 (scripts/dev-db.sh). Uncomment only to point at another server.
# DATABASE_URL=postgresql+psycopg://smartstock:smartstock@localhost:5433/smartstock
# TEST_DATABASE_URL=postgresql+psycopg://smartstock:smartstock@localhost:5433/smartstock_test

# --- Redis / Celery ---
# docker compose uses the `redis` container; without Docker the default is redis://localhost:6379/0
# REDIS_URL=redis://localhost:6379/0

# --- Auth ---
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
LOGIN_RATE_LIMIT_PER_MINUTE=10

# --- Storage (PDFs, uploads, trained models) and backups ---
# docker compose uses /data (volume) and /backups (./backups); without Docker the defaults are backend/data and ./backups
# STORAGE_DIR=data
# BACKUP_DIR=../backups
BACKUP_KEEP=14

# --- Email (SMTP). Mailpit in development: UI at http://localhost:8025 ---
# docker compose defaults to the `mailpit` container; without Docker the default is localhost (run Mailpit locally)
# SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_FROM=SmartStock RPA <noreply@smartstock.local>
EMAIL_ASYNC=true                    # send via the Celery worker; false = send inside the request

# --- Telegram (optional; leave empty to disable) ---
TELEGRAM_BOT_TOKEN=

# --- LLM provider: none | ollama | anthropic | openai (none = rule-based fallbacks everywhere) ---
LLM_PROVIDER=none
LLM_TIMEOUT_SECONDS=30
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Email quotation reader (optional; feature hidden when IMAP_HOST is empty) ---
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# --- OCR ---
TESSERACT_CMD=tesseract

# --- Courier tracking: mock (default, simulated statuses) or shiprocket (tracks the PO's AWB / tracking number) ---
# Shiprocket needs an API user (Settings -> API -> Configure); any failure falls back to the simulated status.
COURIER_PROVIDER=mock
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# --- Frontend build (Vite) ---
VITE_API_BASE=/api/v1
